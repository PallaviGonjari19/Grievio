{
  "expo": {
    "name": "Grievio",
    "slug": "grievio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "grievio",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grievio.campus"
    },
    "android": {
      "package": "com.grievio.campus",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
