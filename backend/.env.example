# Grievio Backend Environment Configuration Template

# Django Security
DEBUG=True
SECRET_KEY=django-insecure-grievio-super-secret-development-key-replace-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL with SQLite fallback)
# Use 'postgresql' or 'sqlite'
DB_ENGINE=sqlite
DB_NAME=grievio_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT Settings
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Media & Storage
MEDIA_URL=/media/
STATIC_URL=/static/
